QJsonObject saved(obs_source_t*s){auto*d=obs_save_source(s);auto o=QJsonDocument::fromJson(obs_data_get_json(d)).object();obs_data_release(d);return o;}
obs_source_t*image(const QString&name,const QString&path){auto*d=obs_data_create();obs_data_set_string(d,"file",path.toUtf8().constData());auto*s=obs_source_create("image_source",name.toUtf8().constData(),d,nullptr);obs_data_release(d);return s;}
int count(obs_source_t*s){int n=0;if(auto*scene=obs_scene_from_source(s))obs_scene_enum_items(scene,[](obs_scene_t*,obs_sceneitem_t*,void*p){++*static_cast<int*>(p);return true;},&n);return n;}
QString uuid(obs_source_t*s){return QString::fromUtf8(obs_source_get_uuid(s));}
void save(const QString&path,QJsonObject o){QFile f(path);if(f.open(QIODevice::WriteOnly))f.write(QJsonDocument(o).toJson());}
