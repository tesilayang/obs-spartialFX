QJsonObject state(){auto*s=stageSource();auto*d=s?currentSettings(s):nullptr;auto o=d?QJsonDocument::fromJson(obs_data_get_json(d)).object():QJsonObject{};obs_data_release(d);obs_source_release(s);return o;}
