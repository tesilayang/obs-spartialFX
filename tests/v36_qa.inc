QJsonObject privateState(){auto*s=stageSource();auto*p=s?obs_source_get_private_settings(s):nullptr;auto*d=p?obs_data_get_obj(p,"spatial_fx_model"):nullptr;auto result=d?QJsonDocument::fromJson(obs_data_get_json(d)).object():QJsonObject{};obs_data_release(d);obs_data_release(p);obs_source_release(s);return result;}
