QJsonObject stageSettings(const QJsonObject&doc){for(auto v:doc["sources"].toArray())if(v.toObject()["id"]=="obs_spatial_fx_stage")return v.toObject()["settings"].toObject();return {};}
void abort(){QTimer::singleShot(100,qApp,finish);}
void confirm(QMessageBox::StandardButton which,const QString&label){QTimer::singleShot(50,qApp,[which,label]{auto*d=qobject_cast<QMessageBox*>(QApplication::activeModalWidget());auto*b=d?d->button(which):nullptr;check(b!=nullptr,label);if(b)b->click();else if(d)d->close();});}
bool graph(const spatial::StageModel&m){std::map<std::string,bool> layers,objects,owners;for(const auto&l:m.layers){if(l.instanceId.empty()||!layers.emplace(l.instanceId,true).second)return false;objects[l.instanceId]=true;}for(const auto&g:m.geometries)objects[g.instanceId]=true;for(const auto&p:m.presetInstances)owners[p.instanceId]=true;for(const auto&g:m.geometries){if(!owners.count(g.ownerId)||(!g.anchorId.empty()&&!layers.count(g.anchorId)))return false;for(const auto&r:g.receivers)if(!layers.count(r))return false;}for(const auto&b:m.motionBlocks)if(!owners.count(b.ownerId)||(!b.camera&&!objects.count(b.targetId)))return false;return true;}
void tab(int index){if(auto*t=panel()->findChild<QTabWidget*>("spatial.tabs"))t->setCurrentIndex(index);pump();}
void choose(const char*name,int index){auto*c=panel()->findChild<QComboBox*>(name);check(c&&index>=0&&index<c->count(),QString("v36 combo available: ")+name);if(c)c->setCurrentIndex(index);}
void flag(const char*name,bool on){auto*c=panel()->findChild<QCheckBox*>(name);check(c!=nullptr,QString("v36 flag available: ")+name);if(c)c->setChecked(on);}
void list(const char*name,int index){auto*l=panel()->findChild<QListWidget*>(name);check(l&&index>=-1&&index<l->count(),QString("v36 role list available: ")+name);if(l)for(int i=0;i<l->count();++i)l->item(i)->setCheckState(i==index?Qt::Checked:Qt::Unchecked);}
void screenshot(const QString&name){check(panel()->grab().save(output+"/"+name+".png"),"v36 native screenshot: "+name);}
void restore(std::function<void()> f){put(base);QTimer::singleShot(100,qApp,[f]{click("spatial.refresh");tab(3);f();});}
