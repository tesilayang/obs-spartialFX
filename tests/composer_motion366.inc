static void checkStageMotion()
{
 StageModel m; Layer actor;actor.instanceId="actor";actor.importWidth=420;actor.importHeight=640; m.layers.push_back(actor);
 ComposeRequest request;request.selectedIds={"actor"};request.motionId="M02";request.decorationAmount=0;
 auto width=[&](const StageModel& input,TimeUs t){auto scene=evaluateSceneAt(input,t);auto q=corners(scene.world[0].plane,420,640);return project(q[1],scene.camera,input.width,input.height).x-project(q[0],scene.camera,input.width,input.height).x;};
 std::string error;auto pushed=m;check(compileComposition(pushed,request,error),"directed push builds");
 const double gain=width(pushed,request.duration/2)/width(pushed,0)-1.;check(gain>=.05&&gain<=.12,"medium dolly produces a measurable 5-12% increase in projected width");
 check(pushed.layers[0].animation.count("z")&&!pushed.layers[0].animation.count("sx"),"space dolly writes depth");
 request.spatialMotion=false;auto flat=m;check(compileComposition(flat,request,error)&&flat.layers[0].animation.count("sx")&&!flat.layers[0].animation.count("z"),"planar push touches only scale");
 request.spatialMotion=true;auto nearObject=m;nearObject.layers[0].plane.position.z=-1485;request.strength=2;check(compileComposition(nearObject,request,error),"near crop guard");check(evaluateSceneAt(nearObject,request.duration/2).world[0].plane.position.z>-1490.,"near clipping threshold respected");
 auto neighbor=m;auto adjacent=actor;adjacent.instanceId="title";adjacent.plane.position.z=-6;neighbor.layers.push_back(adjacent);check(compileComposition(neighbor,request,error),"dolly near another object");const double constrained=evaluateSceneAt(neighbor,request.duration/2).world[0].plane.position.z;check(constrained<0&&constrained>-6,"neighbor depth limits travel without crossing");
 auto orbit=m;orbit.layers[0].orbit.enabled=true;orbit.layers[0].orbit.z=900;orbit.layers[0].orbit.radius=900;request.strength=.6;check(compileComposition(orbit,request,error)&&orbit.layers[0].animation.count("radius")&&!orbit.layers[0].animation.count("z"),"orbit push writes legal radius keys");check(near(width(orbit,request.duration/2),width(pushed,request.duration/2)),"orbit dolly has same on-screen sign as absolute dolly");
 auto turned=m;turned.camera.rotation.y=32;turned.layers[0].plane.position=add(turned.camera.position,rotate({0,0,1500},turned.camera.rotation));check(compileComposition(turned,request,error),"turned camera push");auto evaluated=evaluateSceneAt(turned,request.duration/2);auto projection=project(evaluated.world[0].plane.position,evaluated.camera,turned.width,turned.height);check(near(projection.x,turned.width*.5)&&near(projection.y,turned.height*.5)&&projection.depth<1500,"turned camera depth follows the view axis");
 auto far=m;far.layers[0].plane.position.z=2400;request.motionId="M04";auto close=m;check(compileComposition(close,request,error)&&compileComposition(far,request,error),"sliding dolly fixtures");auto displacement=[](const StageModel& scene){auto e=evaluateSceneAt(scene,1500000);return std::abs(project(e.world[0].plane.position,e.camera,scene.width,scene.height).x-scene.width*.5);};check(displacement(close)>displacement(far)*1.2,"foreground travels farther in screen space than far layer");
 auto tail=m;request.motionId="M28";request.alignMotionStart=true;request.start=1000000;tail.layers[0].plane.position.x=231;check(compileComposition(tail,request,error),"offset entry appended");check(near(evaluateSceneAt(tail,request.start).authoring[0].plane.position.x,231),"append starts from the existing last pose even for an entry template");request.alignMotionStart=false;request.start=0;
 auto repeated=m;request.spatialMotion=true;request.loop=true;request.cycles=2;request.motionId="M08";check(compileComposition(repeated,request,error),"loop motion");const auto& z=repeated.layers[0].animation.at("z");check(near(z.value(0,0),z.value(request.duration,0))&&near(z.value(0,0),z.value(2*request.duration,0)),"depth meets its next cycle with no discontinuity");
}
