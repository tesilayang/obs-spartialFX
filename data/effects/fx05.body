uniform texture2d blur_image;
uniform texture2d environment_image;
uniform float2 source_size;
float fx05_soft_alpha(float2 uv)
{
    if (uv.x < 0 || uv.y < 0 || uv.x > 1 || uv.y > 1) return 0;
    return saturate(blur_image.Sample(fx_sampler, uv).a);
}
float3 fx05_surface(float2 uv, float scale)
{
    return layer_position + ((uv.x - layer_uv_center.x) * layer_right + (uv.y - layer_uv_center.y) * layer_down) * scale;
}

float3 fx05_normal()
{
    return layer_normal / max(length(layer_normal), 0.00001);
}

float3 fx05_ray(float2 uv, float scale)
{
    return lamp_position - fx05_surface(uv, scale);
}

float3 fx05_controlled_ray(float2 uv, float scale, float2 offset, float size)
{
    // UV offsets follow the original lamp projection, including cropping and
    // surface scale. Zero offsets and size one preserve the existing light.
    float surface_scale = max(scale, 0.01);
    float3 normal = fx05_normal();
    float3 lamp_delta = lamp_position - layer_position;
    float depth = dot(lamp_delta, normal);
    float2 center = float2(layer_uv_center.x + offset.x + dot(lamp_delta, layer_right) / max(dot(layer_right, layer_right) * surface_scale, 0.00001),
                           layer_uv_center.y + offset.y + dot(lamp_delta, layer_down) / max(dot(layer_down, layer_down) * surface_scale, 0.00001));
    float3 tangent = ((center.x - uv.x) * layer_right + (center.y - uv.y) * layer_down) * surface_scale;
    return normal * depth + tangent / max(size, 0.01);
}

float fx05_attenuation(float3 ray)
{
    float attenuation = saturate(1.0 - length(ray) / max(lamp_range, 1.0));
    return attenuation * attenuation * max(lamp_intensity, 0.0);
}

float2 fx05_direction(float2 uv, float scale)
{
    float3 ray = fx05_ray(uv, scale);
    float2 projected = float2(dot(ray, layer_right) / max(dot(layer_right, layer_right), 0.00001),
                              dot(ray, layer_down) / max(dot(layer_down, layer_down), 0.00001));
    float2 direction_pixels = projected * canvas_size;
    return direction_pixels / max(length(direction_pixels), 0.00001);
}

float fx05_alpha(float2 uv, float radius)
{
    // Alpha beyond the source rectangle is transparent, never edge-clamped.
    // This also gives opaque rectangular sources a usable inner rim/shadow.
    float2 d = pixel_size * radius;
    float value = src(uv).a * 0.25;
    value += (src(uv + float2(d.x, 0.0)).a + src(uv - float2(d.x, 0.0)).a
            + src(uv + float2(0.0, d.y)).a + src(uv - float2(0.0, d.y)).a) * 0.125;
    value += (src(uv + d).a + src(uv - d).a
            + src(uv + float2(d.x, -d.y)).a + src(uv + float2(-d.x, d.y)).a) * 0.0625;
    return value;
}

float4 fxApply(float2 uv)
{
    float4 c = src(uv);
    if (effect_id == 0) {
        float3 reference = lamp_color;
        if (auxiliary_valid > 0.5) {
            float4 field = environment_image.Sample(fx_sampler, uv);
            if (field.a > 0.00001) reference = field.rgb / field.a;
        }
        float3 ray = fx05_ray(uv, p0.w);
        float facing = saturate(dot(fx05_normal(), ray) / max(length(ray), 0.00001));
        float amount = saturate(p0.x * fx05_attenuation(ray) * lerp(1.0, facing, p0.z));
        if (amount <= 0.0) return c;
        float y = luminance(reference);
        float3 gains = y > 0.00001 ? clamp(reference / y, 0.25, 3.5) : float3(1,1,1);
        gains /= max(luminance(gains), 0.00001);
        float subjectY = max(luminance(c.rgb), 0.0);
        float3 adjusted = c.rgb * lerp(float3(1,1,1), gains, amount);
        adjusted *= subjectY / max(luminance(adjusted), 0.00001);
        // Fit chroma into the available gamut around the unchanged luminance.
        // Avoid clipping saturated reference colors and losing fine contrast.
        float3 chroma = adjusted - subjectY;
        float low = min(min(chroma.r,chroma.g),chroma.b);
        float high = max(max(chroma.r,chroma.g),chroma.b);
        float ceiling = max(max(max(c.r,c.g),c.b),1.0);
        float fit = min(1.0,min(subjectY/max(-low,0.00001),(ceiling-subjectY)/max(high,0.00001)));
        return float4(subjectY + chroma*fit, c.a);
    }
    if (effect_id == 1) {
        float soft = fx05_soft_alpha(uv);
        float2 step_uv = max(p0.x * 0.08, 1.0) / max(source_size,float2(1,1));
        float2 outward = float2(fx05_soft_alpha(uv-float2(step_uv.x,0))-fx05_soft_alpha(uv+float2(step_uv.x,0)),
                                 fx05_soft_alpha(uv-float2(0,step_uv.y))-fx05_soft_alpha(uv+float2(0,step_uv.y)));
        outward /= max(length(outward), 0.00001);
        float2 surfacePoint = (uv-layer_uv_center) * source_size * p1.y;
        float3 ray = float3(p0.y-surfacePoint.x, p0.z-surfacePoint.y, p0.w);
        float distance = max(length(ray), 0.00001);
        float3 direction = ray/distance;
        float facing = 0.25 + 0.75*saturate(dot(outward,direction.xy)+abs(direction.z)*0.4);
        float extent = max(max(source_size.x,source_size.y),1.0);
        float attenuation = 1.0/(1.0+distance*distance/(extent*extent*0.25));
        float behind = 0.5 + 0.5*p0.w/(abs(p0.w)+100.0);
        float amount = max(p1.x,0.0)*attenuation*facing*behind;
        float rim = saturate((1.0-soft)*2.0);
        float4 lit = float4(c.rgb+tint.rgb*rim*amount, c.a);
        float halo = 1.0-exp(-soft*amount*1.5);
        return over(lit,float4(tint.rgb,halo));
    }
    if (effect_id == 2) {
        float3 ray = fx05_controlled_ray(uv, p1.x, p1.yz, p1.w);
        float time = elapsed * p0.y;
        float flutter = (noise21(float2(time, 0.7)) - 0.5) * 1.4;
        flutter += (noise21(float2(time * 3.7, 9.3)) - 0.5) * 0.6;
        float flicker = max(1.0 + flutter * p0.x, 0.0);
        float3 warm = lerp(tint.rgb, tint.rgb * float3(1.0, 0.48, 0.12), p0.z);
        float amount = fx05_attenuation(ray) * p0.w * flicker;
        float facing = 0.3 + 0.7 * saturate(dot(fx05_normal(), ray) / max(length(ray), 0.00001));
        return float4(c.rgb * (1.0 + warm * amount * facing), c.a);
    }
    if (effect_id == 3) {
        float scale = p1.x;
        float3 ray = fx05_controlled_ray(uv, scale, p1.yz, p1.w);
        float3 right_dir = layer_right / max(length(layer_right), 0.00001);
        float3 down_dir = layer_down / max(length(layer_down), 0.00001);
        float2 tangent_ray = float2(dot(ray, right_dir), dot(ray, down_dir));
        float radial = length(tangent_ray) / max(length(layer_right) * scale, 0.00001);
        float spot = 1.0 - smoothstep(p0.x * (1.0 - p0.y), p0.x, radial);
        float amount = spot * fx05_attenuation(ray) * p0.w;
        return float4(c.rgb * (p0.z + tint.rgb * amount), c.a);
    }
    if (effect_id == 4) {
        float3 ray = fx05_ray(uv, p1.z);
        float3 light_dir = ray / max(length(ray), 0.00001);
        float2 gradient = float2(0.0, 0.0);
        if (p1.x > 0.5) {
            gradient.x = luminance(src(uv + float2(pixel_size.x, 0.0)).rgb) - luminance(src(uv - float2(pixel_size.x, 0.0)).rgb);
            gradient.y = luminance(src(uv + float2(0.0, pixel_size.y)).rgb) - luminance(src(uv - float2(0.0, pixel_size.y)).rgb);
            gradient *= p1.y;
        }
        float3 right_dir = layer_right / max(length(layer_right), 0.00001);
        float3 down_dir = layer_down / max(length(layer_down), 0.00001);
        float3 normal = normalize(fx05_normal() + right_dir * (p0.x - gradient.x) + down_dir * (p0.y - gradient.y));
        float3 view = camera_position - fx05_surface(uv, p1.z);
        float3 view_dir = view / max(length(view), 0.00001);
        float3 half_vector = light_dir + view_dir;
        half_vector /= max(length(half_vector), 0.00001);
        float exponent = max(2.0 / max(p0.z * p0.z, 0.0004) - 2.0, 1.0);
        float specular = pow(saturate(dot(normal, half_vector)), exponent);
        // Dielectric Fresnel keeps broad highlights from whitening the entire
        // plane, while allowing stronger reflection at grazing view angles.
        float fresnel = 0.04 + 0.96 * pow(1.0 - saturate(dot(view_dir, half_vector)), 5.0);
        specular *= fresnel * saturate(dot(normal, light_dir)) * p0.w * fx05_attenuation(ray);
        return float4(c.rgb + lamp_color * specular, c.a);
    }
    if (effect_id == 5) {
        float3 ray = fx05_ray(uv, p1.x);
        // Contact shadows use the lamp direction at the surface anchor. A
        // radial direction evaluated per texel pulls every edge inward when
        // the lamp projects inside the silhouette, erasing the inner shadow.
        float2 displacement = -fx05_direction(layer_uv_center, p1.x) * p0.y * pixel_size;
        float shadow_alpha = fx05_alpha(uv - displacement, p0.z);
        float opacity = p0.w * saturate(fx05_attenuation(ray));
        if (p0.x < 0.5) {
            return over(c, float4(tint2.rgb, shadow_alpha * opacity));
        }
        float inside = saturate(1.0 - shadow_alpha) * opacity;
        return float4(lerp(c.rgb, tint2.rgb, inside), c.a);
    }
    return c;
}
